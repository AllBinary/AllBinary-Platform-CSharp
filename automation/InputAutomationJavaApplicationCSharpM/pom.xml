        <outputPath>.\src\main\resources\</outputPath>        
        <dotnet.executable>dotnet</dotnet.executable>
        <dotnet.configuration>Release</dotnet.configuration>
        <!-- Hand written runtime for generated C# code such as Any -->
        <csharp.runtime.source.path>G:/mnt/bc/mydev/workcsharp/j2me/J2SEForCSharpLibraryCSharpM/src/main/java</csharp.runtime.source.path>
