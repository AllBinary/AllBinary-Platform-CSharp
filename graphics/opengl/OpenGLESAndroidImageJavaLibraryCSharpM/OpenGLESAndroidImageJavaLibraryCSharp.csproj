<Project>

  <!-- Keep all dotnet build output under the Maven target directory. These must be set before Sdk.props is imported. -->
  <PropertyGroup>
    <BaseIntermediateOutputPath>$(MSBuildThisFileDirectory)target\dotnet\obj\</BaseIntermediateOutputPath>
    <MSBuildProjectExtensionsPath>$(BaseIntermediateOutputPath)</MSBuildProjectExtensionsPath>
  </PropertyGroup>

  <Import Project="Sdk.props" Sdk="Microsoft.NET.Sdk" />

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <OutputType>Library</OutputType>
    <AssemblyName>OpenGLESAndroidImageJavaLibraryCSharp</AssemblyName>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableDefaultItems>false</EnableDefaultItems>
    <OutputPath Condition="'$(OutputPath)' == ''">$(MSBuildThisFileDirectory)target\dotnet\bin\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <!-- Source directories for the hand written runtime and stub libraries this library compiles with. Set by the pom. -->
    <AllBinaryRuntimeSourcePath Condition="'$(AllBinaryRuntimeSourcePath)' == ''"></AllBinaryRuntimeSourcePath>
    <AllBinaryJsInteropSourcePath Condition="'$(AllBinaryJsInteropSourcePath)' == ''"></AllBinaryJsInteropSourcePath>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="src\main\java\**\*.cs" />
    <Compile Include="$(AllBinaryJsInteropSourcePath)\**\*.cs" Condition="'$(AllBinaryJsInteropSourcePath)' != '' And Exists('$(AllBinaryJsInteropSourcePath)')" />
  </ItemGroup>


  <!-- AllBinary references start. Generated by CSharpPOMsDotnetBuildUpdater from the pom dependencies. -->
  <PropertyGroup>
    <!-- The references below are the whole Maven dependency list so MSBuild does not add its own transitive ones -->
    <DisableTransitiveProjectReferences>true</DisableTransitiveProjectReferences>
    <AllBinaryRuntimeProject Condition="'$(AllBinaryRuntimeSourcePath)' != ''">$(AllBinaryRuntimeSourcePath)\..\..\..\J2SEForCSharpLibraryCSharp.csproj</AllBinaryRuntimeProject>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="$(AllBinaryRuntimeProject)" Condition="'$(AllBinaryRuntimeProject)' != '' And Exists('$(AllBinaryRuntimeProject)')" GlobalPropertiesToRemove="OutputPath" />
    <ProjectReference Include="..\..\..\j2me\logging\LoggingJ2MEAllCSharpM\LoggingJ2MEAllCSharp.csproj" GlobalPropertiesToRemove="OutputPath" />
    <ProjectReference Include="..\..\..\j2me\games\GameConfigurationJavaLibraryCSharpM\GameConfigurationJavaLibraryCSharp.csproj" GlobalPropertiesToRemove="OutputPath" />
    <ProjectReference Include="..\OpenGLESJavaLibraryCSharpM\OpenGLESJavaLibraryCSharp.csproj" GlobalPropertiesToRemove="OutputPath" />
    <!-- org/allbinary/image/opengles/OpenGLESDeviceImageTranslate is also in a nearer dependency -->
    <ProjectReference Include="..\OpenGLESNullImageJavaLibraryCSharpM\OpenGLESNullImageJavaLibraryCSharp.csproj" GlobalPropertiesToRemove="OutputPath" Aliases="OpenGLESNullImageJavaLibraryCSharp" />
    <ProjectReference Include="..\..\..\allbinary_src\logic\data\file\FileJ2SEJavaLibraryCSharpM\FileJ2SEJavaLibraryCSharp.csproj" GlobalPropertiesToRemove="OutputPath" />
    <ProjectReference Include="..\..\..\j2me\media\graphics\ImageCacheJ2MEJavaLibraryCSharpM\ImageCacheJ2MEJavaLibraryCSharp.csproj" GlobalPropertiesToRemove="OutputPath" />
    <ProjectReference Include="..\Min3dForNullJavaLibraryCSharpM\Min3dForNullJavaLibraryCSharp.csproj" GlobalPropertiesToRemove="OutputPath" />
    <ProjectReference Include="..\OpenGLESBaseJavaLibraryCSharpM\OpenGLESBaseJavaLibraryCSharp.csproj" GlobalPropertiesToRemove="OutputPath" />
    <ProjectReference Include="..\..\..\..\working_thirdpartycsharp\embedded\j2me\microemulator\allbinary_custom_android_version\microemulator\microemu-midp\microemu-midpCSharp.csproj" GlobalPropertiesToRemove="OutputPath" />
    <ProjectReference Include="..\..\..\..\working_thirdpartycsharp\embedded\j2me\microemulator\allbinary_custom_android_version\microemulator\microemu-android\microemu-androidCSharp.csproj" GlobalPropertiesToRemove="OutputPath" />
    <ProjectReference Include="..\..\..\allbinary_src\LogCSharpM\LogCSharp.csproj" GlobalPropertiesToRemove="OutputPath" />
    <ProjectReference Include="..\..\..\allbinary_src\licensing\ClientInfoBaseJavaLibraryCSharpM\ClientInfoBaseJavaLibraryCSharp.csproj" GlobalPropertiesToRemove="OutputPath" />
    <ProjectReference Include="..\..\..\j2me\EventJ2MELibraryCSharpM\EventJ2MELibraryCSharp.csproj" GlobalPropertiesToRemove="OutputPath" />
    <ProjectReference Include="..\..\..\j2me\J2MEUtilJavaLibraryCSharpM\J2MEUtilJavaLibraryCSharp.csproj" GlobalPropertiesToRemove="OutputPath" />
    <ProjectReference Include="..\..\..\j2me\lib\BasicMathLibraryCSharpM\BasicMathLibraryCSharp.csproj" GlobalPropertiesToRemove="OutputPath" />
    <ProjectReference Include="..\..\..\j2me\statistics\ApplicationStatisticsJavaLibraryCSharpM\ApplicationStatisticsJavaLibraryCSharp.csproj" GlobalPropertiesToRemove="OutputPath" />
    <ProjectReference Include="..\..\..\allbinary_src\TokenizerJavaLibraryCSharpM\TokenizerJavaLibraryCSharp.csproj" GlobalPropertiesToRemove="OutputPath" />
    <ProjectReference Include="..\..\..\j2me\J2MEColorJavaLibraryCSharpM\J2MEColorJavaLibraryCSharp.csproj" GlobalPropertiesToRemove="OutputPath" />
    <ProjectReference Include="..\..\..\allbinary_src\logic\data\file\FileJavaLibraryCSharpM\FileJavaLibraryCSharp.csproj" GlobalPropertiesToRemove="OutputPath" />
