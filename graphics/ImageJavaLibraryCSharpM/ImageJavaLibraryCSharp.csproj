<Project>

  <!-- Keep all dotnet build output under the Maven target directory. These must be set before Sdk.props is imported. -->
  <PropertyGroup>
    <BaseIntermediateOutputPath>$(MSBuildThisFileDirectory)target\dotnet\obj\</BaseIntermediateOutputPath>
    <MSBuildProjectExtensionsPath>$(BaseIntermediateOutputPath)</MSBuildProjectExtensionsPath>
  </PropertyGroup>

  <Import Project="Sdk.props" Sdk="Microsoft.NET.Sdk" />

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <OutputType>Library</OutputType>
    <AssemblyName>ImageJavaLibraryCSharp</AssemblyName>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableDefaultItems>false</EnableDefaultItems>
    <OutputPath Condition="'$(OutputPath)' == ''">$(MSBuildThisFileDirectory)target\dotnet\bin\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <!-- Source directories for the hand written runtime and stub libraries this library compiles with. Set by the pom. -->
    <AllBinaryRuntimeSourcePath Condition="'$(AllBinaryRuntimeSourcePath)' == ''"></AllBinaryRuntimeSourcePath>
    <AllBinaryJsInteropSourcePath Condition="'$(AllBinaryJsInteropSourcePath)' == ''"></AllBinaryJsInteropSourcePath>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="src\main\java\**\*.cs" />
    <Compile Include="$(AllBinaryJsInteropSourcePath)\**\*.cs" Condition="'$(AllBinaryJsInteropSourcePath)' != '' And Exists('$(AllBinaryJsInteropSourcePath)')" />
  </ItemGroup>


  <!-- AllBinary references start. Generated by CSharpPOMsDotnetBuildUpdater from the pom dependencies. -->
  <PropertyGroup>
    <!-- The references below are the whole Maven dependency list so MSBuild does not add its own transitive ones -->
    <DisableTransitiveProjectReferences>true</DisableTransitiveProjectReferences>
    <AllBinaryRuntimeProject Condition="'$(AllBinaryRuntimeSourcePath)' != ''">$(AllBinaryRuntimeSourcePath)\..\..\..\J2SEForCSharpLibraryCSharp.csproj</AllBinaryRuntimeProject>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="$(AllBinaryRuntimeProject)" Condition="'$(AllBinaryRuntimeProject)' != '' And Exists('$(AllBinaryRuntimeProject)')" GlobalPropertiesToRemove="OutputPath" />
    <ProjectReference Include="..\..\j2me\logging\LoggingJ2MEAllCSharpM\LoggingJ2MEAllCSharp.csproj" GlobalPropertiesToRemove="OutputPath" />
    <ProjectReference Include="..\..\allbinary_src\LogJ2SEJavaLibraryCSharpM\LogJ2SEJavaLibraryCSharp.csproj" GlobalPropertiesToRemove="OutputPath" />
    <ProjectReference Include="..\..\allbinary_src\logic\BasePreloaderFileJavaLibraryCSharpM\BasePreloaderFileJavaLibraryCSharp.csproj" GlobalPropertiesToRemove="OutputPath" />
    <ProjectReference Include="..\..\allbinary_src\logic\data\file\FileJ2SEJavaLibraryCSharpM\FileJ2SEJavaLibraryCSharp.csproj" GlobalPropertiesToRemove="OutputPath" />
    <ProjectReference Include="..\..\j2me\media\graphics\animation\image\ImageJ2SEJavaLibraryCSharpM\ImageJ2SEJavaLibraryCSharp.csproj" GlobalPropertiesToRemove="OutputPath" />
    <ProjectReference Include="..\ColorJavaLibraryCSharpM\ColorJavaLibraryCSharp.csproj" GlobalPropertiesToRemove="OutputPath" />
    <ProjectReference Include="..\..\allbinary_src\cache\AllBinaryCacheLibraryCSharpM\AllBinaryCacheLibraryCSharp.csproj" GlobalPropertiesToRemove="OutputPath" />
    <ProjectReference Include="..\..\allbinary_src\LogCSharpM\LogCSharp.csproj" GlobalPropertiesToRemove="OutputPath" />
    <ProjectReference Include="..\..\j2me\CommonJavaLibraryCSharpM\CommonJavaLibraryCSharp.csproj" GlobalPropertiesToRemove="OutputPath" />
    <ProjectReference Include="..\..\allbinary_src\J2SEExceptionLibraryCSharpM\J2SEExceptionLibraryCSharp.csproj" GlobalPropertiesToRemove="OutputPath" />
    <ProjectReference Include="..\..\allbinary_src\allbinary_src_designpatterns_srcCSharpM\allbinary_src_designpatterns_srcCSharp.csproj" GlobalPropertiesToRemove="OutputPath" />
    <ProjectReference Include="..\..\allbinary_src\logic\BasePreloaderJ2MEJavaLibraryCSharpM\BasePreloaderJ2MEJavaLibraryCSharp.csproj" GlobalPropertiesToRemove="OutputPath" />
    <ProjectReference Include="..\..\allbinary_src\logic\data\file\FileJavaLibraryCSharpM\FileJavaLibraryCSharp.csproj" GlobalPropertiesToRemove="OutputPath" />
    <ProjectReference Include="..\..\allbinary_src\cache\BaseCacheJavaLibraryCSharpM\BaseCacheJavaLibraryCSharp.csproj" GlobalPropertiesToRemove="OutputPath" />
    <ProjectReference Include="..\..\replace_these_stub_projects\allbinary_src\J2MEJsInteropCompatibilityJavaLibraryCSharpM\J2MEJsInteropCompatibilityJavaLibraryCSharp.csproj" GlobalPropertiesToRemove="OutputPath" />
    <ProjectReference Include="..\..\j2me\J2MEUtilJavaLibraryCSharpM\J2MEUtilJavaLibraryCSharp.csproj" GlobalPropertiesToRemove="OutputPath" />
    <ProjectReference Include="..\..\j2me\lib\BaseMathLibraryCSharpM\BaseMathLibraryCSharp.csproj" GlobalPropertiesToRemove="OutputPath" />
  </ItemGroup>
  <!-- AllBinary references end -->

  <Import Project="Sdk.targets" Sdk="Microsoft.NET.Sdk" />

  <Target Name="AllBinaryWarnMissingDependencySources" BeforeTargets="CoreCompile">
    <Warning Text="C# runtime source directory does not exist: $(AllBinaryRuntimeSourcePath)" Condition="'$(AllBinaryRuntimeSourcePath)' != '' And !Exists('$(AllBinaryRuntimeSourcePath)')" />
    <Warning Text="C# jsinterop source directory does not exist: $(AllBinaryJsInteropSourcePath)" Condition="'$(AllBinaryJsInteropSourcePath)' != '' And !Exists('$(AllBinaryJsInteropSourcePath)')" />
  </Target>

</Project>
