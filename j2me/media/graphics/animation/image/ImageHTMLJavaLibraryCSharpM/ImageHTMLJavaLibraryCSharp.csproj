<Project>

  <!-- Keep all dotnet build output under the Maven target directory. These must be set before Sdk.props is imported. -->
  <PropertyGroup>
    <BaseIntermediateOutputPath>$(MSBuildThisFileDirectory)target\dotnet\obj\</BaseIntermediateOutputPath>
    <MSBuildProjectExtensionsPath>$(BaseIntermediateOutputPath)</MSBuildProjectExtensionsPath>
  </PropertyGroup>

  <Import Project="Sdk.props" Sdk="Microsoft.NET.Sdk" />

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <OutputType>Library</OutputType>
    <AssemblyName>ImageHTMLJavaLibraryCSharp</AssemblyName>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableDefaultItems>false</EnableDefaultItems>
    <OutputPath Condition="'$(OutputPath)' == ''">$(MSBuildThisFileDirectory)target\dotnet\bin\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <!-- Source directories for the hand written runtime and stub libraries this library compiles with. Set by the pom. -->
    <AllBinaryRuntimeSourcePath Condition="'$(AllBinaryRuntimeSourcePath)' == ''"></AllBinaryRuntimeSourcePath>
    <AllBinaryJsInteropSourcePath Condition="'$(AllBinaryJsInteropSourcePath)' == ''"></AllBinaryJsInteropSourcePath>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="src\main\java\**\*.cs" />
    <Compile Include="$(AllBinaryJsInteropSourcePath)\**\*.cs" Condition="'$(AllBinaryJsInteropSourcePath)' != '' And Exists('$(AllBinaryJsInteropSourcePath)')" />
  </ItemGroup>


  <!-- AllBinary references start. Generated by CSharpPOMsDotnetBuildUpdater from the pom dependencies. -->
  <PropertyGroup>
    <!-- The references below are the whole Maven dependency list so MSBuild does not add its own transitive ones -->
    <DisableTransitiveProjectReferences>true</DisableTransitiveProjectReferences>
    <AllBinaryRuntimeProject Condition="'$(AllBinaryRuntimeSourcePath)' != ''">$(AllBinaryRuntimeSourcePath)\..\..\..\J2SEForCSharpLibraryCSharp.csproj</AllBinaryRuntimeProject>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="$(AllBinaryRuntimeProject)" Condition="'$(AllBinaryRuntimeProject)' != '' And Exists('$(AllBinaryRuntimeProject)')" GlobalPropertiesToRemove="OutputPath" />
    <ProjectReference Include="..\..\..\..\..\logging\LoggingJ2MEAllCSharpM\LoggingJ2MEAllCSharp.csproj" GlobalPropertiesToRemove="OutputPath" />
    <ProjectReference Include="..\..\..\..\..\..\allbinary_src\LogJ2MEJavaLibraryCSharpM\LogJ2MEJavaLibraryCSharp.csproj" GlobalPropertiesToRemove="OutputPath" />
    <ProjectReference Include="..\..\..\ImageCacheJ2MEJavaLibraryCSharpM\ImageCacheJ2MEJavaLibraryCSharp.csproj" GlobalPropertiesToRemove="OutputPath" />
    <ProjectReference Include="..\..\..\..\..\..\..\working_thirdpartycsharp\embedded\j2me\microemulator\microemu-playn\microemu-playnCSharp.csproj" GlobalPropertiesToRemove="OutputPath" />
    <ProjectReference Include="..\..\..\..\..\..\graphics\opengl\OpenGLNoneJavaLibraryCSharpM\OpenGLNoneJavaLibraryCSharp.csproj" GlobalPropertiesToRemove="OutputPath" />
    <ProjectReference Include="..\..\..\..\..\..\..\working_thirdpartycsharp\embedded\j2me\microemulator\allbinary_custom_android_version\microemulator\microemu-midp\microemu-midpCSharp.csproj" GlobalPropertiesToRemove="OutputPath" />
    <ProjectReference Include="..\..\..\..\..\..\..\working_thirdpartycsharp\embedded\j2me\microemulator\allbinary_custom_android_version\microemulator\microemu-extensions\microemu-jsr-135\microemu-jsr-135CSharp.csproj" GlobalPropertiesToRemove="OutputPath" />
    <ProjectReference Include="..\..\..\..\..\..\allbinary_src\LogCSharpM\LogCSharp.csproj" GlobalPropertiesToRemove="OutputPath" />
    <ProjectReference Include="..\..\..\..\..\CommonJavaLibraryCSharpM\CommonJavaLibraryCSharp.csproj" GlobalPropertiesToRemove="OutputPath" />
    <ProjectReference Include="..\..\..\..\..\J2MEExceptionLibraryCSharpM\J2MEExceptionLibraryCSharp.csproj" GlobalPropertiesToRemove="OutputPath" />
    <ProjectReference Include="..\..\..\..\..\DebugJavaLibraryCSharpM\DebugJavaLibraryCSharp.csproj" GlobalPropertiesToRemove="OutputPath" />
    <ProjectReference Include="..\..\..\..\..\J2MEUtilJavaLibraryCSharpM\J2MEUtilJavaLibraryCSharp.csproj" GlobalPropertiesToRemove="OutputPath" />
    <ProjectReference Include="..\..\..\ImageCacheBaseJ2MEJavaLibraryCSharpM\ImageCacheBaseJ2MEJavaLibraryCSharp.csproj" GlobalPropertiesToRemove="OutputPath" />
    <ProjectReference Include="..\..\..\..\..\statistics\ApplicationStatisticsJavaLibraryCSharpM\ApplicationStatisticsJavaLibraryCSharp.csproj" GlobalPropertiesToRemove="OutputPath" />
    <ProjectReference Include="..\..\..\..\..\..\..\working_thirdpartycsharp\graphics\playn\allbinary_version\playn_my_microedition\java\playn-javaCSharp.csproj" GlobalPropertiesToRemove="OutputPath" />
    <ProjectReference Include="..\..\..\..\..\..\..\working_thirdpartycsharp\embedded\j2me\microemulator\allbinary_custom_android_version\microemulator\microemu-cldc\microemu-cldcCSharp.csproj" GlobalPropertiesToRemove="OutputPath" />
    <ProjectReference Include="..\..\..\..\..\..\replace_these_stub_projects\allbinary_src\J2MEJsInteropCompatibilityJavaLibraryCSharpM\J2MEJsInteropCompatibilityJavaLibraryCSharp.csproj" GlobalPropertiesToRemove="OutputPath" />
    <ProjectReference Include="..\..\..\..\..\lib\BaseMathLibraryCSharpM\BaseMathLibraryCSharp.csproj" GlobalPropertiesToRemove="OutputPath" />
    <ProjectReference Include="..\..\..\..\..\NullJ2MELibraryCSharpM\NullJ2MELibraryCSharp.csproj" GlobalPropertiesToRemove="OutputPath" />
    <ProjectReference Include="..\..\..\..\..\time\TimeJavaLibraryCSharpM\TimeJavaLibraryCSharp.csproj" GlobalPropertiesToRemove="OutputPath" />
    <ProjectReference Include="..\..\..\..\..\lib\BasicMathLibraryCSharpM\BasicMathLibraryCSharp.csproj" GlobalPropertiesToRemove="OutputPath" />
    <ProjectReference Include="..\..\..\..\..\..\..\working_thirdpartycsharp\graphics\playn\allbinary_version\playn_my_microedition\core\playn-coreCSharp.csproj" GlobalPropertiesToRemove="OutputPath" />
    <ProjectReference Include="..\..\..\..\..\..\..\working_thirdpartycsharp\media\jlayerCSharpM\jlayerCSharp.csproj" GlobalPropertiesToRemove="OutputPath" />
    <ProjectReference Include="..\..\..\..\..\..\allbinary_src\allbinary_src_designpatterns_srcCSharpM\allbinary_src_designpatterns_srcCSharp.csproj" GlobalPropertiesToRemove="OutputPath" />
  </ItemGroup>
  <!-- AllBinary references end -->

  <Import Project="Sdk.targets" Sdk="Microsoft.NET.Sdk" />

  <Target Name="AllBinaryWarnMissingDependencySources" BeforeTargets="CoreCompile">
    <Warning Text="C# runtime source directory does not exist: $(AllBinaryRuntimeSourcePath)" Condition="'$(AllBinaryRuntimeSourcePath)' != '' And !Exists('$(AllBinaryRuntimeSourcePath)')" />
    <Warning Text="C# jsinterop source directory does not exist: $(AllBinaryJsInteropSourcePath)" Condition="'$(AllBinaryJsInteropSourcePath)' != '' And !Exists('$(AllBinaryJsInteropSourcePath)')" />
  </Target>

</Project>
