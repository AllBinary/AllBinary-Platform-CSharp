<Project>

  <!-- Keep all dotnet build output under the Maven target directory. These must be set before Sdk.props is imported. -->
  <PropertyGroup>
    <BaseIntermediateOutputPath>$(MSBuildThisFileDirectory)target\dotnet\obj\</BaseIntermediateOutputPath>
    <MSBuildProjectExtensionsPath>$(BaseIntermediateOutputPath)</MSBuildProjectExtensionsPath>
  </PropertyGroup>

  <Import Project="Sdk.props" Sdk="Microsoft.NET.Sdk" />

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <OutputType>Library</OutputType>
    <AssemblyName>LicenseClientJavaLibraryCSharp</AssemblyName>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableDefaultItems>false</EnableDefaultItems>
    <OutputPath Condition="'$(OutputPath)' == ''">$(MSBuildThisFileDirectory)target\dotnet\bin\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <!-- Source directories for the hand written runtime and stub libraries this library compiles with. Set by the pom. -->
    <AllBinaryRuntimeSourcePath Condition="'$(AllBinaryRuntimeSourcePath)' == ''"></AllBinaryRuntimeSourcePath>
    <AllBinaryJsInteropSourcePath Condition="'$(AllBinaryJsInteropSourcePath)' == ''"></AllBinaryJsInteropSourcePath>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="src\main\java\**\*.cs" />
    <Compile Include="$(AllBinaryJsInteropSourcePath)\**\*.cs" Condition="'$(AllBinaryJsInteropSourcePath)' != '' And Exists('$(AllBinaryJsInteropSourcePath)')" />
  </ItemGroup>


  <!-- AllBinary references start. Generated by CSharpPOMsDotnetBuildUpdater from the pom dependencies. -->
  <PropertyGroup>
    <!-- The references below are the whole Maven dependency list so MSBuild does not add its own transitive ones -->
    <DisableTransitiveProjectReferences>true</DisableTransitiveProjectReferences>
    <AllBinaryRuntimeProject Condition="'$(AllBinaryRuntimeSourcePath)' != ''">$(AllBinaryRuntimeSourcePath)\..\..\..\J2SEForCSharpLibraryCSharp.csproj</AllBinaryRuntimeProject>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="$(AllBinaryRuntimeProject)" Condition="'$(AllBinaryRuntimeProject)' != '' And Exists('$(AllBinaryRuntimeProject)')" GlobalPropertiesToRemove="OutputPath" />
    <ProjectReference Include="..\..\..\j2me\logging\LoggingJ2MEAllCSharpM\LoggingJ2MEAllCSharp.csproj" GlobalPropertiesToRemove="OutputPath" />
    <ProjectReference Include="..\..\LogJ2MEJavaLibraryCSharpM\LogJ2MEJavaLibraryCSharp.csproj" GlobalPropertiesToRemove="OutputPath" />
    <ProjectReference Include="..\..\..\j2me\ProgressJ2MEJavaLibraryCSharpM\ProgressJ2MEJavaLibraryCSharp.csproj" GlobalPropertiesToRemove="OutputPath" />
    <ProjectReference Include="..\RemoteXmlRpcJavaLibraryCSharpM\RemoteXmlRpcJavaLibraryCSharp.csproj" GlobalPropertiesToRemove="OutputPath" />
    <ProjectReference Include="..\..\logic\BasePreloaderJavaLibraryCSharpM\BasePreloaderJavaLibraryCSharp.csproj" GlobalPropertiesToRemove="OutputPath" />
    <ProjectReference Include="..\..\hardware\BaseHardwareJavaLibraryCSharpM\BaseHardwareJavaLibraryCSharp.csproj" GlobalPropertiesToRemove="OutputPath" />
    <ProjectReference Include="..\..\hardware\BaseOperatingSystemJavaLibraryCSharpM\BaseOperatingSystemJavaLibraryCSharp.csproj" GlobalPropertiesToRemove="OutputPath" />
    <ProjectReference Include="..\..\hardware\BaseSystemJavaLibraryCSharpM\BaseSystemJavaLibraryCSharp.csproj" GlobalPropertiesToRemove="OutputPath" />
    <ProjectReference Include="..\..\hardware\NoSystemJavaLibraryCSharpM\NoSystemJavaLibraryCSharp.csproj" GlobalPropertiesToRemove="OutputPath" />
    <ProjectReference Include="..\ClientInfoLicensingJavaLibraryCSharpM\ClientInfoLicensingJavaLibraryCSharp.csproj" GlobalPropertiesToRemove="OutputPath" />
    <ProjectReference Include="..\ClientInfoBaseJavaLibraryCSharpM\ClientInfoBaseJavaLibraryCSharp.csproj" GlobalPropertiesToRemove="OutputPath" />
    <ProjectReference Include="..\..\allbinary_src_designpatterns_srcCSharpM\allbinary_src_designpatterns_srcCSharp.csproj" GlobalPropertiesToRemove="OutputPath" />
    <ProjectReference Include="..\FileLicenseInitInfoJavaLibraryCSharpM\FileLicenseInitInfoJavaLibraryCSharp.csproj" GlobalPropertiesToRemove="OutputPath" />
    <ProjectReference Include="..\..\..\replace_these_stub_projects\security\YourSecurityJavaLibraryCSharpM\YourSecurityJavaLibraryCSharp.csproj" GlobalPropertiesToRemove="OutputPath" />
    <ProjectReference Include="..\..\..\replace_these_stub_projects\communication\YourXmlRpcJavaLibraryCSharpM\YourXmlRpcJavaLibraryCSharp.csproj" GlobalPropertiesToRemove="OutputPath" />
    <ProjectReference Include="..\..\LogCSharpM\LogCSharp.csproj" GlobalPropertiesToRemove="OutputPath" />
    <ProjectReference Include="..\..\..\j2me\CommonJavaLibraryCSharpM\CommonJavaLibraryCSharp.csproj" GlobalPropertiesToRemove="OutputPath" />
    <ProjectReference Include="..\..\..\j2me\J2MEExceptionLibraryCSharpM\J2MEExceptionLibraryCSharp.csproj" GlobalPropertiesToRemove="OutputPath" />
    <ProjectReference Include="..\..\..\j2me\games\PreGameJ2MEJavaLibraryCSharpM\PreGameJ2MEJavaLibraryCSharp.csproj" GlobalPropertiesToRemove="OutputPath" />
    <ProjectReference Include="..\..\..\j2me\AllBinaryJ2MELibraryCSharpM\AllBinaryJ2MELibraryCSharp.csproj" GlobalPropertiesToRemove="OutputPath" />
    <ProjectReference Include="..\..\..\j2me\J2MEUtilJavaLibraryCSharpM\J2MEUtilJavaLibraryCSharp.csproj" GlobalPropertiesToRemove="OutputPath" />
